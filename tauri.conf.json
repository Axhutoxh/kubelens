{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kubellens",
  "version": "1.3.0",
  "identifier": "io.kubellens.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "assets/splash"
  },
  "app": {
    "windows": [
      {
        "title": "KUBELLENS - Lens by ACP",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Native Kubernetes IDE",
    "longDescription": "Kubellens is a fast, native Kubernetes desktop IDE built with Rust, Tauri, Tokio and React: pod shell and smart logs, bulk image tags with live rollout tracking, cluster-to-cluster diffs, safe ConfigMap edits, pod alerts and Helm, in ~30 MB of RAM.",
    "category": "DeveloperTool",
    "publisher": "Ashutosh Chandra",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
